  "cross_family_merges": [
    {
      "members": [
        "ADS-GPUOPS-001",
        "ADS-GRM-013"
      ],
      "title": "KEDA examples use incomplete Prometheus contracts and incompatible vLLM units",
      "reason": "Both examples require the same endpoint, exported metric, workload aggregation and target-unit corrections."
    },
    {
      "members": [
        "ADS-CHIT-003",
        "ADS-KV-007",
        "ADS-LLMD-001"
      ],
      "title": "Round-robin routing is incorrectly said to eliminate engine prefix-cache reuse",
      "reason": "The same false cache-miss premise recurs across three chapters; the EN latency assertion remains in its original occurrence."
    },
    {
      "members": [
        "ADS-GPUOPS-017",
        "ADS-LLMD-011"
      ],
      "title": "Applied GPU quota examples are mislabeled as default quotas",
      "reason": "Both identify the same 384/64 applied values incorrectly presented as defaults."
    },
    {
      "members": [
        "ADS-GRM-005",
        "ADS-GRM-016"
      ],
      "title": "Device Plugin capabilities are incorrectly excluded in the DRA comparison",
      "reason": "Narrative and table repeat the same Device Plugin/MIG/time-slicing exclusion."
    },
    {
      "members": [
        "ADS-GRM-017",
        "ADS-GRM-018",
        "ADS-GRM-019"
      ],
      "title": "English cost tables render unrelated component inventories",
      "reason": "Three imported table branches contain the same wrong-table substitution; each component and its unsupported KO price assumptions remain individually located."
    },
    {
      "members": [
        "ADS-SERVIDX001",
        "ADS-TIER-001"
      ],
      "title": "Gateway diagrams put EPP in the data-forwarding path",
      "reason": "The repeated diagram misrepresents EPP decision RPCs as model-request proxying; the tool-branch destination concern is retained."
    },
    {
      "members": [
        "ADS-GPUOPS-012",
        "ADS-NODE-024"
      ],
      "title": "English GPU availability text loses the stated April support scope",
      "reason": "Both refer to the same historical p6 support correction. Account/region Spot availability remains unverified."
    }
  ],
