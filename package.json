{
  "name": "engineering-playbook",
  "version": "1.0.0",
  "description": "Cloud Native Architecture Engineering Playbook & Benchmark Reports",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "generate-summary": "node scripts/generate-summary.js",
    "generate-llms": "node scripts/generate-llms-txt.js --out build",
    "generate-llm-wiki": "node scripts/generate-llm-wiki.js --out build",
    "test:llm-wiki": "node --test scripts/tests/llm-wiki-components.test.js",
    "test:links": "node --test scripts/tests/validate-links.test.js",
    "test:tags": "node --test scripts/tests/tag-pages.test.js",
    "test:tools": "node --test scripts/tests/document-tools/*.test.cjs",
    "test:ssr": "node --test scripts/tests/ssr-unicode.test.js",
    "new-post": "node scripts/new-post.js",
    "validate-metadata": "node scripts/validate-metadata-new.js",
    "update-doc-metadata": "node scripts/update-doc-metadata.js",
    "test:metadata": "node --test scripts/tests/doc-metadata.test.js",
    "test:gateway-benchmark": "node --test scripts/tests/gateway-conformance.test.cjs && node scripts/benchmarks/gateway-api-benchmark/analyze-conformance.cjs --check && PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s scripts/benchmarks/gateway-api-benchmark -p test_harness.py -v",
    "validate-links": "node scripts/validate-links.js",
    "generate-tags": "node scripts/generate-tag-pages.js",
    "auto-categorize": "node scripts/auto-categorize.js",
    "algolia-index": "node scripts/algolia-index.js",
    "sync": "npm run generate-summary && git add . && git commit -m 'Update SUMMARY.md' && git push"
  },
  "dependencies": {
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/plugin-ideal-image": "^3.9.2",
    "@docusaurus/plugin-pwa": "^3.9.2",
