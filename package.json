    "@easyops-cn/docusaurus-search-local": "^0.52.3",
    "@mdx-js/react": "^3.0.0",
    "@xyflow/react": "^12.10.1",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "roughjs": "^4.6.6",
    "shell-quote": "^1.8.4"
  },
  "devDependencies": {
    "@babel/parser": "7.29.0",
    "@docusaurus/module-type-aliases": "^3.9.2",
    "@docusaurus/plugin-client-redirects": "3.9.2",
